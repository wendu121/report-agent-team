# TD-006 .env.example · 全量环境变量模板（复制为 .env 后填值；.env 已被 .gitignore 忽略）
# compose 自动读取本文件供 ${} 替换；api 服务经 env_file 注入 NEWAPI_*/TAVILY_API_KEY

# ===== 数据库（非机密，compose 内拼接连接串） =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=report_agent_team

# ===== new-api 网关（引擎真实调用，必须注入；否则引擎子进程连不上 LLM） =====
# 容器内访问宿主网关：Docker Desktop 用 host.docker.internal；Linux 裸 docker 可加 extra_hosts 或填宿主机 IP
NEWAPI_BASE_URL=http://host.docker.internal:3000/v1
NEWAPI_API_KEY=mm-your-key-here
NEWAPI_MAX_RETRIES=5
NEWAPI_TIMEOUT=120

# ===== 检索（可选；留空则 MOCK 降级，不验证检索内容真实性） =====
TAVILY_API_KEY=

# ===== 引擎（仅 CLI 直接运行用，容器内经 server 子进程固定真实客户端，无需设置） =====
# MODE=stub
# STUB_SCENARIO=
# REAL_TOPIC=
# REAL_SCOPE=
